# EMS API / worker configuration (spec Section 34). Synthetic values only; secrets come from the environment, never git.

# API connects as ems_app, the worker as ems_worker. Never ems_owner or a superuser: they bypass row-level security.
DATABASE_URL=postgresql+psycopg://ems_app:CHANGE_ME@localhost:5432/ems
WORKER_DATABASE_URL=postgresql+psycopg://ems_worker:CHANGE_ME@localhost:5432/ems
# Migrations only (alembic upgrade head), run as an admin role in a one-off task.
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/ems

APP_BASE_URL=http://localhost:3000
SESSION_COOKIE_SECURE=true
# 64 hexadecimal characters, e.g. python -c "import secrets; print(secrets.token_hex(32))"
CSRF_SECRET=

# Empty -> GOOGLE_NOT_CONFIGURED (OD-07). Set both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Empty -> MEDIA_UNAVAILABLE for screen-share tokens; presence keeps working. Set all three or none.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Chrome extension ID for the CORS allow-list (OD-03).
EXTENSION_ID=

# Only "none" is implemented (INT-003 blocked until OD-09); any other value stops the API at start-up.
EMAIL_PROVIDER=none
# Only "disabled" is implemented (INT-006 blocked until OD-06).
AI_REPHRASER=disabled
LOG_LEVEL=info

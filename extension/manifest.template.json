{
  "manifest_version": 3,
  "name": "EMS Employee Room",
  "short_name": "EMS",
  "version": "1.0.0",
  "description": "Check in and out, take breaks and share your screen with your company on EMS. Nothing is recorded; every view is shown to you.",
  "minimum_chrome_version": "120",
  "permissions": ["idle", "storage", "alarms", "cookies"],
  "host_permissions": ["__EMS_ORIGIN__/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup/popup.html", "default_title": "EMS" },
  "options_page": "settings/settings.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
